<Project Sdk="Snowyyd.NET.Sdk/1.1.0">

  <PropertyGroup>
    <!-- Project -->
    <OutputType>library</OutputType>
    <TargetFramework>netstandard2.1</TargetFramework>
    <!-- <RootNamespace>LuaLoader</RootNamespace> -->
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>

    <!-- Plugin properties -->
    <AssemblyName>LuaLoader</AssemblyName>
    <Product>LuaLoader</Product>
    <Version>1.0.0</Version>

    <!-- Lang features -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <WarningsAsErrors></WarningsAsErrors> <!-- TODO: remove this (disables <WarningsAsErrors>nullable</WarningsAsErrors>) -->

    <!-- Publish -->
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NLua" Version="1.7.9" />
  </ItemGroup>

  <!-- BepInEx & Unity -->
  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.*" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" />
    <PackageReference Include="UnityEngine.Modules" Version="6000.4.8" IncludeAssets="compile" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework.TrimEnd(`0123456789`))' == 'net'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.2" PrivateAssets="all" />
  </ItemGroup>

  <!-- Local references -->
  <ItemGroup>
    <LocalReferences Include="References/*.dll" Exclude="References/netstandard.dll;References/System*.dll;References/mscorlib.dll" />
    <Reference Include="@(LocalReferences)" Private="false" />
  </ItemGroup>

</Project>
